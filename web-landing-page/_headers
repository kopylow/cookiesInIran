/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-PYicaFFcRks6DHDKrFoGl5h7bct6HdIWlTmVBW5BG2Q=' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; img-src 'self' data: https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; media-src 'self' https://audio.cookiesiniran.com; font-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/api/*
  Cache-Control: no-store

# Source CSS/JS are referenced (versioned) from the always-fresh HTML
# (index.html is served max-age=0). The default Pages caching for these assets
# (max-age=14400) made edits invisible for up to 4h. no-cache lets the browser
# revalidate every load (cheap 304s) so a deploy is visible immediately. Hashed
# font files keep their long cache; only these hand-edited text assets revalidate.
/styles.css
  Cache-Control: no-cache
/main.js
  Cache-Control: no-cache
/comments.js
  Cache-Control: no-cache
/audiobook.js
  Cache-Control: no-cache

/admin*
  X-Robots-Tag: noindex, nofollow
